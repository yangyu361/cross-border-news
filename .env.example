# 跨境早报 - 推送配置文件
# 复制此文件为 .env，填入你自己的 Key
# 只需要配置一个渠道即可，也可配置多个同时推送

# ============ 方案 A：企业微信群机器人（推荐，支持直接推图片） ============
# 获取方式：企业微信群 → 右上角 → 添加群机器人 → 复制 Webhook 地址
# Webhook 地址格式：https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxx
# 只需要填 key 部分
WECHAT_WEBHOOK_KEY=

# ============ 方案 B：Server酱（推送到个人微信） ============
# 获取地址：https://sct.ftqq.com
# 登录后点击「发送消息」即可获取 SCT 开头的 Key
SERVERCHAN_SCKEY=

# ============ 方案 C：钉钉群机器人 ============
# 获取方式：钉钉群 → 群设置 → 智能群助手 → 添加机器人 → 自定义
# Webhook 地址格式：https://oapi.dingtalk.com/robot/send?access_token=xxxxx
# 只需要填 access_token 部分
DINGTALK_WEBHOOK_KEY=

# ============ 方案 D：飞书群机器人 ============
# 获取方式：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
# 填入完整的 Webhook URL
FEISHU_WEBHOOK_URL=
